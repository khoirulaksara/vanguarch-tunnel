{
  "productName": "vanguarch",
  "version": "2.1.0",
  "identifier": "com.vanguarch.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vanguarch Tunnel",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "backgroundColor": [9, 9, 11, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
