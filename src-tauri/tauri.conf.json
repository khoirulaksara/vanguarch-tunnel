{
  "productName": "Vanguarch",
  "version": "2.4.0",
  "identifier": "com.vanguarch.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vanguarch Tunnel",
        "width": 1024,
        "height": 768,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "backgroundColor": [9, 9, 11, 255],
        "transparent": false,
        "decorations": false
      
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "VanguArchangel",
    "copyright": "Copyright © 2026 VanguArchangel. All rights reserved.",
    "shortDescription": "A stable, predictable UI wrapper for cloudflared and local development tunneling.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "bannerPath": "icons/wix_banner.bmp",
        "dialogImagePath": "icons/wix_dialog.bmp"
      }
    }
  }
}
